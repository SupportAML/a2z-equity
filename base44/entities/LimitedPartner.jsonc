{
  "name": "LimitedPartner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the Limited Partner"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "commitment_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Total commitment amount"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "LP status"
    },
    "onboarding_date": {
      "type": "string",
      "format": "date",
      "description": "Date when LP joined"
    },
    "accredited_investor": {
      "type": "boolean",
      "default": true,
      "description": "Whether LP is an accredited investor"
    }
  },
  "required": [
    "name",
    "commitment_amount"
  ]
}