{
  "name": "CapitalActivity",
  "type": "object",
  "properties": {
    "lp_id": {
      "type": "string",
      "description": "The ID of the Limited Partner"
    },
    "type": {
      "type": "string",
      "enum": [
        "contribution",
        "distribution",
        "funds_received"
      ],
      "description": "The type of capital activity - contribution (capital called), funds_received (actual cash received), or distribution"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "The amount of the transaction"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "The date of the transaction"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about the transaction"
    },
    "deal_id": {
      "type": "string",
      "description": "The ID of the associated deal, if any"
    },
    "is_autogenerated_from_investment": {
      "type": "boolean",
      "default": false,
      "description": "Flag to indicate if the activity was auto-generated from a deal investment"
    }
  },
  "required": [
    "lp_id",
    "type",
    "amount",
    "date"
  ]
}